# Optional libpq/psql connection settings. Copy to .env and fill locally.
# No file is loaded automatically; export settings before running psql.
PGHOST=localhost
PGPORT=5432
PGDATABASE=goodwill_db
PGUSER=
# Prefer a password prompt or a locally protected .pgpass file.
PGPASSWORD=

# Fill email settings ONLY in git-ignored root .env. Gmail uses an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
