# Copy to chatbot/.env (git-ignored) and fill in locally. Never commit real keys.
# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Read-only role from chatbot/setup_readonly_role.sql; point at the database to query.
CHATBOT_DATABASE_URL=postgresql://goodwill_chatbot@localhost:5432/goodwill_db_test
# Optional
CHATBOT_MODEL=claude-opus-5-5
CHATBOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
